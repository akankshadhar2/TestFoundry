# Copy to .env (gitignored) and fill in. Values are never printed or sent to Claude.

# Stripe TEST secret key: Dashboard -> Developers -> API keys (test mode). sk_test_... or rk_test_...
# Live keys (anything containing _live_) are refused everywhere.
STRIPE_TEST_KEY=

# Claude: leave ANTHROPIC_API_KEY empty to use Claude Code (`claude`, on your Claude subscription,
# no API billing). Set it to use the paid Anthropic API instead (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: force the Claude backend: auto (default) | api | cli
# CLAUDE_BACKEND=auto

# Optional: Claude model (default: claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: effort level sent to Claude (low|medium|high|xhigh|max). Unset = model default.
# Lower is faster on stage.
# CLAUDE_EFFORT=medium

# Optional: which provider module to use (providers/<name>_provider.py). Default: stripe
# DEMO_PROVIDER=stripe
